# Passwords for docker-compose.prod.yml. On the server the deploy writes .env from Vault
# (kv/scamazon, one key per line below). Locally: copy to .env and fill in.
# Avoid ' (single quote): the values are written inside single quotes in .env.
MONGO_ROOT_PASSWORD=
# Flask session key for home-page-service, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
